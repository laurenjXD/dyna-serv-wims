# Copy to .env.local and fill in real values. Never commit real secrets.

# --- Supabase ---
# Project URL and publishable key (safe for browser exposure). The legacy
# anon-key name is supported by the app as a migration fallback only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-only, never exposed to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
# Drizzle ORM connection string (Supabase Postgres, pooler URL recommended).
DATABASE_URL=
# Vercel's Supabase integration may provide this name instead; the runtime
# accepts either value, with DATABASE_URL taking precedence.
# POSTGRES_URL=

# --- Resend (transactional email) ---
RESEND_API_KEY=
# Verified sending domain/address used for auth + notification emails.
RESEND_FROM_EMAIL=

# --- Upstash Redis (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Sentry (error monitoring) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Auth token for source-map upload during build (CI only, never client-side).
SENTRY_AUTH_TOKEN=

# --- App ---
NEXT_PUBLIC_APP_URL=
